{
  "name": "Pharma Gospel",
  "short_name": "PharmaGospel",
  "description": "Outils et assistants pour l'officine",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#006d44",
  "icons": [
    {
      "src": "./favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    },
    {
      "src": "./assets/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "./#views/ordoscan/ordoscan.html",
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif"],
        "application/pdf": [".pdf"]
      }
    }
  ]
}